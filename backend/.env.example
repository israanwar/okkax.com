# Local-only MongoDB. Do not point this at Emergent or another production database.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=okkax_local

# Generate unique local values; never commit the resulting backend/.env file.
JWT_SECRET=replace-with-a-long-random-local-value
DEMO_PASSWORD=replace-with-a-local-demo-password
ADMIN_EMAIL=admin.local@okkax.id
ADMIN_PASSWORD=replace-with-a-local-admin-password

CORS_ORIGINS=http://localhost:3000
STRIPE_IDR_USD_RATE=16000

# Optional Emergent-only integrations. Leave blank for normal local development.
EMERGENT_LLM_KEY=
STRIPE_API_KEY=

# ==============================================================================
# OKKAX NON-PAYMENT EXTERNAL INTEGRATIONS (Optional / Feature-Flagged)
# ==============================================================================

# AI & Multi-LLM Routing
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Transactional Email (Resend)
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@okkax.com

# WhatsApp Cloud API / Provider
WHATSAPP_ENABLED=false
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BASE_URL=https://graph.facebook.com/v19.0

# Push Notifications (Firebase Cloud Messaging)
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Google Maps Platform (Places & Routes)
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# BMKG Open Data Weather (Always Enabled - Public Open API)
BMKG_ENABLED=true
BMKG_BASE_URL=https://data.bmkg.go.id/DataMKG/MEWS/DigitalForecast

# Cloudflare R2 / AWS S3 Compatible Object Storage
STORAGE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=okkax-storage
R2_ENDPOINT=

# Media Enrichment (Spotify & YouTube)
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=

# Certified E-Signatures (PrivyID / PSrE)
PRIVY_ENABLED=false
PRIVY_API_KEY=
PRIVY_MERCHANT_KEY=
